# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/docyra

# Auth
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# CSRF
CSRF_SECRET=your_csrf_secret_key_min_32_characters_long_for_security

# 2FA
TOTP_ISSUER=Docyra

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASS=testpass
EMAIL_FROM=no-reply@docyra.app

# SMS (MSG91)
MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_SENDER_ID=DOCYRA

# File storage
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_S3_BUCKET=docyra-uploads
AWS_REGION=ap-south-1

# CAPTCHA
RECAPTCHA_SECRET_KEY=mock_recaptcha_secret_key

# Monitoring
SENTRY_DSN=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200,https://patient.docyra.app,https://portal.docyra.app
